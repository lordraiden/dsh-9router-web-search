{
  "name": "dsh-web-search-9router",
  "version": "0.2.3",
  "description": "9router-backed web search + fetch providers for DeepSeek Harness (ctx.web). Wires the native web_search/web_fetch tools to 9router's /v1/search and /v1/web/fetch endpoints.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "web-fetch",
    "9router"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "zustand": "5.0.15"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <1.0.0",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.1 <1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "immer": "10.2.0",
    "react": "18.3.1"
  }
}
